{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill SnowEyes Collection Record",
  "type": "object",
  "required": [
    "scope_ref",
    "run_id",
    "observed_at",
    "collector",
    "input",
    "category",
    "value",
    "confidence",
    "dedupe_key",
    "evidence"
  ],
  "properties": {
    "scope_ref": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "collector": {"type": "string", "enum": ["fofa", "hunter", "quake", "threatbook", "zoomeye", "snoweyes", "browser"]},
    "collector_version": {"type": "string"},
    "input": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"type": "string", "enum": ["url", "html", "javascript", "response", "browser", "search_mcp"]},
        "ref": {"type": "string"},
        "method": {"type": "string"},
        "auth_context": {"type": "string"}
      },
      "additionalProperties": false
    },
    "category": {"type": "string", "enum": ["asset", "domain", "endpoint", "route", "api", "script", "technology", "identity", "parameter", "document", "evidence", "lead"]},
    "value": {"type": "string", "minLength": 1},
    "masked_preview": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["candidate", "confirmed", "duplicate", "blocked"]},
    "dedupe_key": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"type": "string", "enum": ["excerpt", "hash", "request", "response", "search_result", "browser_event"]},
        "ref": {"type": "string"},
        "excerpt": {"type": "string"},
        "sha256": {"type": "string"}
      },
      "additionalProperties": false
    },
    "links": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
