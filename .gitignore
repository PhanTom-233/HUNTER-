# 分发包（npm run pack:share 生成，不进版本库）
release/

# 依赖与构建产物
node_modules/
dist/
dist-server/
dist-ssr/
.vite/

# 运行时数据（用户自己的资产库与报告，绝不进版本库）
data/
/reports/
!.gitignore

# 日志与临时文件
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak
.DS_Store
Thumbs.db

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/

# 环境变量（可能含密钥）
.env
.env.local
.env.*.local
