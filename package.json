{
  "name": "hunter",
  "private": true,
  "version": "1.0.0",
  "description": "渗透测试工作流管理台（本地单机，只做记录/编排/建议）",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check:refs": "node scripts/check-refs.mjs",
    "verify": "npm run typecheck && npm run check:refs && npm run build",
    "skill:index": "node scripts/build-skill-index.mjs",
    "bundle:server": "node scripts/bundle-server.mjs",
    "start": "node dist-server/server.bundle.cjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.9.3",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
